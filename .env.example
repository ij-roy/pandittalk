# Root local-runtime configuration. Copy to .env before docker compose up.

COMPOSE_PROJECT_NAME=pandittalk

# PostgreSQL
POSTGRES_USER=pandittalk
POSTGRES_PASSWORD=pandittalk-local-only
POSTGRES_DB=pandittalk
DATABASE_URL=postgresql://pandittalk:pandittalk-local-only@postgres:5432/pandittalk?schema=public&connection_limit=10&pool_timeout=20

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend ports inside the Compose network
USER_SERVICE_PORT=3001
PANDIT_SERVICE_PORT=3002

# Browser origins. Add the Vercel website/dashboard and tunnel origins here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Local-only AWS-compatible DynamoDB adapter used by the current chat history implementation.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=ap-south-1
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_TABLE_CHAT=pandittalk-chat-messages

# Local development auth and provider defaults.
JWT_SECRET=replace-with-a-long-local-development-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
CHAT_WAITING_TIMEOUT_MS=30000
OTP_SMS_PROVIDER=none
# Local-only fixed OTP mode. Keep false in any non-local environment.
ALLOW_TEST_OTP=true
TEST_OTP_PHONE_ALLOWLIST=+919999999998,+919999999997,+919999999996

# Local media storage. Keep uploads in the named Docker volume.
AVATAR_STORAGE=local
AVATAR_UPLOAD_DIR=/app/uploads/avatars
AVATAR_PUBLIC_BASE_URL=http://localhost:3001/static/avatars

# Optional external providers. Leave empty for local smoke tests unless the feature needs them.
AWS_CHIME_ACCESS_KEY_ID=
AWS_CHIME_SECRET_ACCESS_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
OPENAI_API_KEY=

# Optional TURN profile. Do not commit real credentials.
TURN_REALM=localhost
TURN_USERNAME=pandittalk
TURN_PASSWORD=local-turn-password
