# Copy to .env. Managed URLs take precedence; blank managed URLs use the
# local PostgreSQL, Redis, and MongoDB services in docker-compose.yml.

COMPOSE_PROJECT_NAME=pandittalk
NODE_ENV=development
API_PUBLIC_URL=http://localhost:3001
API_EXTERNAL_PORT=3001
USER_SERVICE_PORT=3001
PANDIT_SERVICE_PORT=3002

# Supabase PostgreSQL is the business-data source of truth. Use the pooler URL
# for application traffic and the direct URL for Prisma migrations when needed.
# Leave DATABASE_URL blank only for the local Compose PostgreSQL fallback.
POSTGRES_USER=pandittalk
POSTGRES_PASSWORD=pandittalk-local-only
POSTGRES_DB=pandittalk
DATABASE_URL=
DIRECT_URL=

# Redis Cloud. Use the complete rediss:// URL exactly as provided by Redis Cloud.
# Blank values use the local Compose Redis fallback.
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379

# MongoDB Atlas stores chat history only. Blank URI uses the local Compose MongoDB fallback.
MONGODB_URI=
MONGODB_DATABASE=pandittalk

# Browser origins, not backend origin URLs. Include every deployed website,
# dashboard, and local/tunnel origin that sends credentialed requests.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Auth and session safety.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
CHAT_WAITING_TIMEOUT_MS=600000

# OTP. Test OTP must remain disabled outside an isolated local test run.
OTP_SMS_PROVIDER=none
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
ALLOW_TEST_OTP=false
TEST_OTP_PHONE_ALLOWLIST=
ADMIN_TEST_OTP_PHONE_ALLOWLIST=

# Cloudinary is the managed media store. Use AVATAR_STORAGE=local only for
# an intentionally local-only run.
AVATAR_STORAGE=local
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_PUBLIC_BASE_URL=http://localhost:3001/static/avatars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pandittalk

# Browser-native WebRTC media. Add TURN values for restrictive NATs.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Payments and other provider integrations. Secrets stay server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
OPENAI_API_KEY=

# Optional local coturn profile. Do not commit real credentials.
TURN_REALM=localhost
TURN_USERNAME=pandittalk
TURN_PASSWORD=local-turn-password
