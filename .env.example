# Production Compose configuration. Copy this file to .env and fill every
# managed-service secret before running docker compose up.

COMPOSE_PROJECT_NAME=pandittalk
NODE_ENV=production
API_PUBLIC_URL=https://pandittalk-load-balancer.admininfo-6d6.workers.dev
API_EXTERNAL_PORT=3001
USER_SERVICE_PORT=3001
PANDIT_SERVICE_PORT=3002

# Supabase PostgreSQL is the business-data source of truth.
# Use the Supabase session-pooler URL for DATABASE_URL and DIRECT_URL when
# IPv4 access is required. URL-encode special characters in the password.
DATABASE_URL=
DIRECT_URL=

# Redis Cloud is the shared cache, OTP, lock, queue, and Socket.IO store.
# Use the complete rediss:// URL exactly as provided by Redis Cloud.
REDIS_URL=

# MongoDB Atlas stores chat history.
MONGODB_URI=
MONGODB_DATABASE=pandittalk

# Credentialed browser origins. Keep the stable Worker hostname out of this
# list; it is the API origin, not a browser Origin.
ALLOWED_ORIGINS=https://www.pandittalk.com,https://pandittalk.com,https://dashboard.pandittalk.com

# Auth and session safety.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
CHAT_WAITING_TIMEOUT_MS=600000

# OTP. Test OTP stays disabled in production.
OTP_SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
ALLOW_TEST_OTP=false
TEST_OTP_PHONE_ALLOWLIST=
ADMIN_TEST_OTP_PHONE_ALLOWLIST=

# Cloudinary is the production media store.
AVATAR_STORAGE=cloudinary
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pandittalk

# Browser/native WebRTC media.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_CREDENTIAL_TTL_SECONDS=86400

# Payments and optional provider integrations. Keep secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
OPENAI_API_KEY=

# Optional local coturn profile only. Production media uses Cloudflare TURN.
TURN_REALM=localhost
TURN_USERNAME=pandittalk
TURN_PASSWORD=local-turn-password
