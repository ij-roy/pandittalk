{
  "name": "PanditTalk-Backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "nest build user-service && nest build pandit-service && nest build common",
    "build:user-service": "nest build user-service",
    "build:pandit-service": "nest build pandit-service",
    "build:common": "nest build common",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start user-service",
    "start:dev": "nest start user-service --watch",
    "start:debug": "nest start user-service --debug --watch",
    "start:user-service": "nest start user-service",
    "start:user-service:dev": "nest start user-service --watch",
    "start:pandit-service": "nest start pandit-service",
    "start:pandit-service:dev": "nest start pandit-service --watch",
    "start:prod": "node dist/apps/user-service/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" --no-fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:user-service": "jest --config ./apps/user-service/test/jest-e2e.json",
    "test:e2e:pandit-service": "jest --config ./apps/pandit-service/test/jest-e2e.json",
    "prisma:generate": "prisma generate --schema apps/user-service/prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prisma:migrate": "prisma migrate dev --schema apps/user-service/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema apps/user-service/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema apps/user-service/prisma/schema.prisma",
    "reset:tool": "ts-node scripts/reset-tool-unlock.ts",
    "ensure:app-review-demo": "ts-node scripts/ensure-app-review-demo-user.ts",
    "upload:pandit-portraits": "ts-node scripts/upload-pandit-portraits.ts",
    "reconcile:pandit-ids": "ts-node scripts/reconcile-pandit-ids.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.27",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "apple-signin-auth": "^2.1.0",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "google-auth-library": "^11.0.2",
    "mongodb": "^6.22.0",
    "openai": "^6.42.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "razorpay": "^2.9.6",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "postinstall": "prisma generate --schema apps/user-service/prisma/schema.prisma",
  "prisma": {
    "seed": "ts-node apps/user-service/prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@pandittalk/common$": "<rootDir>/libs/common/src",
      "^@pandittalk/common/(.*)$": "<rootDir>/libs/common/src/$1"
    }
  }
}
