# Copy to .env and adjust for local development (Nest apps read from repo root or per-app paths in ConfigModule).

# user-service
USER_SERVICE_PORT=3001

# Comma-separated extra browser origins for CORS.
# Production always also allows https://www.pandittalk.com, https://pandittalk.com,
# and https://dashboard.pandittalk.com.
# Example: http://localhost:5173,http://localhost:3000
# ALLOWED_ORIGINS=

# pandit-service
PANDIT_SERVICE_PORT=3002

# PostgreSQL (matches docker-compose.yml)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=pandittalk
DATABASE_PASSWORD=pandittalk
DATABASE_NAME=pandittalk

# Prisma user-service datasource (constructed from compose credentials when local)
DATABASE_URL=postgresql://pandittalk:pandittalk@localhost:5432/pandittalk?schema=public&connection_limit=10&pool_timeout=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS DynamoDB (chat messages)
# Local: use docker-compose dynamodb service and dummy credentials below.
# Production: omit DYNAMODB_ENDPOINT and set real AWS credentials.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=ap-south-1
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_CHAT=pandittalk-chat-messages

# AWS Chime SDK Meetings (real IAM credentials required; not compatible with local DynamoDB dummy keys)
# IAM needs chime:CreateMeeting, chime:CreateAttendee, chime:DeleteMeeting in ap-south-1
AWS_CHIME_ACCESS_KEY_ID=replace-me
AWS_CHIME_SECRET_ACCESS_KEY=replace-me

# Chat waiting room timeout before auto-refund (ms). Use 30000 locally for testing; production default 600000 (10 min).
CHAT_WAITING_TIMEOUT_MS=600000

# RabbitMQ (AMQP)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=pandittalk
RABBITMQ_PASSWORD=pandittalk

# JWT (user-service auth). Use a long random value in non-local environments.
JWT_SECRET=replace-me-with-a-long-random-string
# Short-lived access token (pair with refresh tokens in auth_sessions).
JWT_EXPIRES_IN=15m
# Opaque refresh token lifetime (days). Stored hashed in Postgres.
REFRESH_TOKEN_TTL_DAYS=30
# Refresh cookie Secure flag. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# OTP SMS (default: console-log only; set msg91 when DLT template is approved)
# OTP_SMS_PROVIDER=none
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=

# Test OTP bypass (local/dev only; defaults to off). Never enable in production.
# ALLOW_TEST_OTP never claims SMS was sent for allowlisted numbers — see auth.service.
# ALLOW_TEST_OTP=false

# Test OTP phone allowlist (comma-separated E.164). When ALLOW_TEST_OTP=false, ONLY these
# numbers may use OTP 1234 and skip SMS. Everyone else always uses a real SMS OTP.
# Do not document 1234 as a general login code for seeded pandit phones.
# TEST_OTP_PHONE_ALLOWLIST=+919999999998
# Local-only Admin demo phone. It is honored only when ALLOW_TEST_OTP=true.
# ADMIN_TEST_OTP_PHONE_ALLOWLIST=+919999999996

# Mobile force/soft update gate (GET /public/app-update) — #236
# IOS_LATEST_VERSION=1.0.9
# IOS_MIN_SUPPORTED_VERSION=1.0.0
# ANDROID_LATEST_VERSION=1.0.9
# ANDROID_MIN_SUPPORTED_VERSION=1.0.0
# IOS_STORE_URL=https://apps.apple.com/app/id6797837559
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.pandittalk.mobile
# APP_UPDATE_MESSAGE=A new version of PanditTalk is available.

# Razorpay
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_ANY_STRONG_STRING

# Prokerala Astrology API
PROKERALA_CLIENT_ID=replace-me
PROKERALA_CLIENT_SECRET=replace-me

# OpenAI
OPENAI_API_KEY=replace-me

# Profile avatar uploads
# AVATAR_STORAGE: local (dev disk) | s3 (production CDN via CloudFront)
# Infra (ap-south-1): bucket pandittalk-media, CloudFront d3ffeab65q7qta.cloudfront.net
# Production ECS uses the task role (ecs-task-policy.json); values also in Secrets Manager pandittalk/prod
AVATAR_STORAGE=local
# Local-only settings (ignored when AVATAR_STORAGE=s3)
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_PUBLIC_BASE_URL=http://localhost:3001/static/avatars
# S3 + CloudFront (required when AVATAR_STORAGE=s3)
# Local dev: set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY for a scoped IAM user or AWS SSO profile
S3_MEDIA_BUCKET=pandittalk-media
S3_MEDIA_REGION=ap-south-1
MEDIA_CDN_URL=https://d3ffeab65q7qta.cloudfront.net

# Google Blogger sync (optional — syncs posts into articles table)
# GOOGLE_BLOGGER_API_KEY=replace-me
# GOOGLE_BLOGGER_BLOG_ID=replace-me
# BLOGGER_SYNC_ON_STARTUP=false
# BLOGGER_SYNC_SECRET=replace-me-for-manual-sync-endpoint

# Google Sign-In — comma-separated OAuth 2.0 client IDs (Web, iOS, Android)
# GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com,yyyy.apps.googleusercontent.com
# APPLE_CLIENT_ID=com.pandittalk.mobile
