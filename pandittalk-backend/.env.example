# Direct backend-run configuration. Docker production uses the root .env.
# Fill managed services before using npm run start:prod.

NODE_ENV=production
USER_SERVICE_PORT=3001
PANDIT_SERVICE_PORT=3002
API_PUBLIC_URL=https://pandittalk-load-balancer.admininfo-6d6.workers.dev

ALLOWED_ORIGINS=https://www.pandittalk.com,https://pandittalk.com,https://dashboard.pandittalk.com

# Supabase PostgreSQL.
DATABASE_URL=
DIRECT_URL=

# Redis Cloud.
REDIS_URL=

# MongoDB Atlas.
MONGODB_URI=
MONGODB_DATABASE=pandittalk

# Browser-native WebRTC media.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_CREDENTIAL_TTL_SECONDS=86400
CHAT_WAITING_TIMEOUT_MS=600000

# JWT and cookie safety.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true

# OTP.
OTP_SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
ALLOW_TEST_OTP=false
TEST_OTP_PHONE_ALLOWLIST=
ADMIN_TEST_OTP_PHONE_ALLOWLIST=

# Cloudinary managed media storage.
AVATAR_STORAGE=cloudinary
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pandittalk

# Payments and optional integrations.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
OPENAI_API_KEY=
