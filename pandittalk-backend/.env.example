# Backend-only local fallback. The root .env is used by Docker Compose.

USER_SERVICE_PORT=3001
PANDIT_SERVICE_PORT=3002
API_PUBLIC_URL=https://pandittalk-load-balancer.admininfo-6d6.workers.dev

# Exact browser origins allowed to send credentialed requests.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Supabase PostgreSQL in managed mode; local PostgreSQL fallback shown here.
DATABASE_URL=postgresql://pandittalk:pandittalk@localhost:5432/pandittalk?schema=public&connection_limit=10&pool_timeout=20
DIRECT_URL=postgresql://pandittalk:pandittalk@localhost:5432/pandittalk?schema=public&connection_limit=10&pool_timeout=20

# Redis Cloud managed mode accepts rediss://; local fallback is below.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB Atlas managed mode; local MongoDB fallback shown here.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pandittalk

# Browser-native WebRTC media.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
CHAT_WAITING_TIMEOUT_MS=600000

# JWT and cookie safety.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# OTP: use MSG91 in managed mode; fixed test OTP is disabled by default.
OTP_SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
ALLOW_TEST_OTP=false
TEST_OTP_PHONE_ALLOWLIST=
ADMIN_TEST_OTP_PHONE_ALLOWLIST=

# Cloudinary managed media storage.
AVATAR_STORAGE=local
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_PUBLIC_BASE_URL=http://localhost:3001/static/avatars
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pandittalk

# Existing optional integrations.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_CREDENTIAL_TTL_SECONDS=86400
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
OPENAI_API_KEY=
