# Copy to .env and adjust for local development

# Razorpay test Key ID only (secret stays on the backend)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# NestJS user-service URL
# Production release builds default to https://api.pandittalk.com when unset.
# Override for local dev (physical device — use your LAN IP):
# EXPO_PUBLIC_API_BASE=http://192.168.1.10:3001
# Android emulator reaches host via 10.0.2.2 when unset in dev:
# EXPO_PUBLIC_API_BASE=http://10.0.2.2:3001

# Firebase / Google Sign-In (client-safe). Get OAuth client IDs from
# Firebase Authentication → Google, or Cloud Console → Credentials.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com

# EAS production/preview builds: set the three EXPO_PUBLIC_* keys above as
# Expo project Environment variables (not in eas.json). See docs/EAS_IOS_SUBMIT.md.
