SITE_URL=https://www.pandittalk.com
# Optional override for client-visible absolute URLs; falls back to SITE_URL.
NEXT_PUBLIC_SITE_URL=https://www.pandittalk.com

# Public API host used by sitemap/articles helpers (site.ts). Prefer matching production.
API_BASE=https://api.pandittalk.com
NEXT_PUBLIC_API_BASE=https://api.pandittalk.com
DASHBOARD_URL=https://dashboard.pandittalk.com

# Server-only browser adapter configuration. Never expose these as NEXT_PUBLIC_ values.
# BACKEND_URL is preferred by the /api/backend proxy; falls back to API_BASE.
BACKEND_URL=https://api.pandittalk.com
# Expected Origin for same-site mutation checks (must match the deployed website).
APP_ORIGIN=https://www.pandittalk.com
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-characters
GOOGLE_WEB_CLIENT_ID=
APPLE_WEB_CLIENT_ID=
APPLE_WEB_REDIRECT_URI=
# Required only when BROWSER_SESSIONS_ENABLED=true for live chat/audio/video sockets.
# SOCKET_URL should point to the public API origin for existing browser chat/audio/video rooms.
SOCKET_URL=http://localhost:3001
BROWSER_SESSIONS_ENABLED=false
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.pandittalk.mobile
# Google Apps Script (or equivalent) endpoint for NotifyOpenForm waitlist posts.
# Optional: if unset at build time, NotifyOpenForm falls back to the production Apps Script URL.
NEXT_PUBLIC_NOTIFY_SHEET_URL=https://script.google.com/macros/s/AKfycbwDCdsm2ZUpkFRwhNJx6uMvyywLjHH2xfOw54Y8IjsZRHqr1RSM0hSW6TbUv9oitALGsw/exec
